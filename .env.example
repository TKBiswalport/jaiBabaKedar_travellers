PORT=5000
# PostgreSQL connection string (e.g. from Neon: postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=your_postgres_connection_string
# Only needed once, to copy old data with `npm run migrate:mongo`
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Frontend URLs (for CORS)
FRONTEND_URL=https://jaibabakedar.com

# Twilio WhatsApp (get from twilio.com)
# Sandbox number (testing): +14155238886
# Production: your approved Twilio WhatsApp sender number
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+14155238886s
# Razorpay (Dashboard -> Account & Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Razorpay webhook secret (Dashboard -> Webhooks), for the order.paid event
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
# Testing only: every booking costs this many rupees instead of the real price. Remove before going live.
# TEST_BOOKING_PRICE=1
